\section{Ecology}

\subsubsection{I. Fundamentals of Ecology}
\textbf{ 1. Biology}\\
 \cite{curtis_biology_1983} \textbf{[pp. 49-75; 157-232]}\\
\underline{Carbon chemistry}
\begin{itemize}
	\item $1s^{2}2s^{2}2p^{2}$ 
	\item $\Rightarrow sp^{3}$ hybrid orbitals; single covalent bonds
	\item $\Rightarrow sp^{2}$ hybrid orbitals; double covalent bonds
	\item $\Rightarrow sp^{1}$ hybrid orbitals; triple covalent bonds
	\item Oxidation states: -4 ($CH_{4}$) to +4 ($CO_{2}$)
	\item Reaction types: 1) Substitution, 2) Elimination, 3) Addition, 4) Rearrangement
	\item Functional groups: 1) -OH alcohols (hydroxy), 2) -COOH carboxylic acid (carboxyl), 3) -NH2 amine (amino), 4) -CHO aldehyde, 5) -CHO- ketone, 6)-PO(OH)2 phosphate
\end{itemize}
\underline{Carbohydrates (sugars)}
\begin{itemize}
	\item $(CH_2O)_n$ "hydrates of carbon"
	\item monosaccharides [glucose, $C_6H_{12}O_6$ (an aldose); fructose, $C_6H_{12}O_6$ (a ketose)]
	\item $ \Rightarrow $ principal energy source: $C_6H_{12}O_6 + 6O_2 \rightarrow 6CO_2 + 6H_2O \ \Delta H = -673 kcal$
	\item disaccharides [sucrose, condensation of glucose + fructose; $1\rightarrow 2$ linkage]
	\item $ \Rightarrow $ transport from photosynthesis
	\item polysaccharides: storage: starch (amylose, amylopectin) and glycogen; $\alpha$ linked glucose
	\item polysaccharides: structure: cellulose $\beta $ linked glucose; chitin $\beta $ linked glucose w/ N
\end{itemize}
\underline{Lipids (fats, oils, waxes)}
\begin{itemize}
	\item fats: glycerol + 3 fatty acids (esterification)
	\item $ \Rightarrow $ 6x more energy stored (per wgt) than polysaccharides; hydrophobic
	\item $ \Rightarrow $ organ cushion; insulation
	\item phospholipids: glycerol + 2 fatty acids (esterification) + 1 phosphate; hydrophobic and hydrophyllic ends; cell membrane
\end{itemize}
\underline{Proteins (polypeptides}
\begin{itemize}
	\item 20 amino acids: $H_2N-CHR-COOH $; only R varies
	\item amide (ester) linkage: $H_2N-CHR-CO-NH-CHR-COOH$; dipeptide
	\item primary (sequence), secondary (H bonds); tertiary (S cross links); quaternary (multiple polypeptides)
	\item structural: collagen (gelatin), keratin
	\item regulatory: insulin
	\item transport: hemoglobin
	\item storage: seed
	\item protective: antibodies
	\item toxins: diptheria, botulism
	\item enzymes: sucrase  
\end{itemize}
\underline{Nucleic acids}
\begin{itemize}
	\item purines (adenine, guanine), pyrimidines (cytosine, thymine) + sugar (ribose) + phosphate
	\item deoxyribonucleic acid, ribonucleic acid, tRNA, mRNA
\end{itemize}
\underline{Thermodynamics}
\begin{itemize}
	\item only $\sim 1\% \ of \ 1.3x10^{24} cal$ of solar energy enters biosphere
	\item only $\sim 10\%$ energy transfer per trophic level
	\item Energetics of reactions: Gibbs free energy $\equiv \Delta G = \Delta H - T\Delta S$; exergonic $ \equiv \Delta G \leq 0$; endergonic	$ \equiv \Delta G > 0$
	\item First Law: Total energy of an isolated system constant
	\item Second Law: Time's arrow; Transformations from potential energy sources accompanied by heat (friction; non-usable energy) or increase in entropy;  Potential energy of final state LESS than initial state IF $\Delta G \leq 0$
\end{itemize}
\underline{Fundamental BioEnergy Cycle (Redox)}
\begin{itemize}
	\item Chloroplast: : $6CO_2 + 6H_2O \rightarrow C_6H_{12}O_6 + 6O_2 \ \Delta G = +680 kcal$
	\item Mitochondrion: $C_6H_{12}O_6 + 6O_2 \rightarrow 6CO_2 + 6H_2O \ \Delta G = -680 kcal$
	\item Metabolism: molecular construction rxns (anabolism) + molecular deconstruction rxns (catabolism)
	\item Metabolism: couple an endergonic rxn with hydrolysis of ATP (exergonic $\sim 7 \ kcal/mol$; often phosphorylation of a reactant(s)) \\
	Example: glucose + fructose + 2ATP $ \rightarrow $ sucrose
	\item ATP: adenine + ribose + 3 phosphates = adenosine triphosphate
\end{itemize}
\underline{Enzymes}
\begin{itemize}
	\item Large globular proteins;  catalysts; Reduction of activation potential
	\item Active site + substrate $ \rightarrow $ products
	\item Coenzymes (vitamins, cations) needed often as electron acceptors (eg, nictotinamide adenine dinucleotide (NAD) = niacin)
	\item pH and temp affected; denatured = lost structure ($ 3^{o}, 4^{o}$)
	\item Enzymatic pathways prevent equilibrium; move rxns forward
	\item Auxotroph: lack critical enzyme fxning at some point in the pathway (missing or defective enzyme)
	\item Control of enzyme-mediated rxns with 1) activation enzymes; 2) temp/pH; 3) allosteric factors; 4) feedback inhibition; 5) competitive inhibition (sulfanilamide for PABA in folic acid synthesis); 6) noncompetitive inhibition (Pb poisoning binds to -SH and denatures enzymes); 7) irreversible inhibition (nerve toxins, penicillin on bacterial cell wall construction)
\end{itemize}
\underline{Glycolysis and Respiration}
\begin{itemize}
	\item Aerobic ATP Production: glycolysis + respiration $ \equiv $ (Krebs cycle + electron transport)
	\item Glycolysis (in cytoplasm): Phosphorylation of glucose (by kinases)  $ \Rightarrow $ splits glucose to 2, 3C glyceraldehyde phospahtes $ \Rightarrow $  Oxidation to pyruvic acid $H_{3}CCOCOOH$; 9 steps \\
	Glycolysis: 2 ATP + 2 NAD+ $ \Rightarrow $ 4 ATP + 2NADH \\
	Glycolysis: controlled by negative feedback of ATP: phosphofructokinase is an allosteric enzyme with ATP itself being the allosteric factor
	\item Pyruvic acid can go aerobic (respiration) or anaerobic (fermentation to ethanol; oxygen debt to lactic acid)
	\item Respiration (in mitochondrion): pyruvic acid - CO2 + CoenzymeA  $\Rightarrow $ actyl CoA \\
	Acetyl CoA enters Krebs cycle $ \Rightarrow $ ATP + NADH + CO2 +H2O \\
	NADH enters oxidative phosphorylation (electron transport) $ \Rightarrow $ ATP + H2O
	\item Paul Mitchell (Nobel chemistry, 1976) proposed radical (ingenious) idea that oxidative phosphorylation of ADP to ATP in mitochondria powered by proton gradient (like active transport); proton gradient creates pH gradient and voltage gradient; met with skepticism for 20 yrs
\end{itemize}

